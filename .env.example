# EasyRecruit AI — Environment Variables

# Backend API URL (FastAPI server)
# In production, set this to your deployed backend URL
NEXT_PUBLIC_API_URL=http://localhost:8001

# Backend CORS origins (comma-separated list of allowed frontend URLs)
# Set this to your deployed frontend URL in production, e.g.:
#   CORS_ORIGINS=https://your-app.bolt.new
# Use * only for development. When using specific origins, credentials
# and cookies work correctly for authenticated requests.
CORS_ORIGINS=*
